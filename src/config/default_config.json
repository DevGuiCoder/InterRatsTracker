{
  "app": {
    "name": "InterRats Tracker",
    "version": "0.1.0"
  },
  "paths": {
    "data_dir": "data",
    "logs_dir": "logs",
    "reports_dir": "reports"
  },
  "monitoring": {
    "default_duration_minutes": 15,
    "default_interval_seconds": 2.0,
    "default_sip_target": "sip.exemplo.local",
    "default_sip_port": 5060,
    "default_protocol": "TCP",
    "default_external_target": "1.1.1.1",
    "external_ip_targets": ["1.1.1.1", "8.8.8.8"],
    "domain_targets": ["example.com", "cloudflare.com"],
    "marker_context_before_seconds": 120,
    "marker_context_after_seconds": 120,
    "marker_debounce_seconds": 5.0,
    "marker_pre_context_seconds": 120,
    "marker_post_context_seconds": 120,
    "marker_click_cooldown_seconds": 5.0,
    "marker_correlation_strong_seconds": 15,
    "marker_correlation_moderate_seconds": 45,
    "marker_correlation_weak_seconds": 120,
    "warmup_seconds": 10,
    "minimum_samples_for_jitter": 5,
    "minimum_samples_for_alerts": 5,
    "monitor_start_stagger_ms": 250,
    "jitter_window_samples": 30,
    "max_concurrent_checks": 3,
    "exclude_warmup_from_summary": true,
    "store_warmup_measurements": true,
    "snapshot_queue_size": 20,
    "snapshot_timeout_seconds": 10.0,
    "sip_options_enabled": true,
    "sip_options_interval_seconds": 30.0,
    "sip_options_timeout_seconds": 3.0,
    "sip_transports": ["UDP", "TCP"],
    "route_trace_cooldown_seconds": 300,
    "public_ip_interval_seconds": 300,
    "public_ip_providers": [
      "https://api.ipify.org",
      "https://ifconfig.me/ip"
    ],
    "udp_flow_test": {
      "enabled": false,
      "host": "",
      "port": 0,
      "duration_seconds": 10.0,
      "interval_seconds": 0.02,
      "payload_size_bytes": 64
    },
    "system_alert_min_duration_seconds": 5,
    "audio_monitoring_enabled": true,
    "audio_poll_interval_seconds": 2.0,
    "audio_level_monitoring_enabled": false,
    "audio_level_window_seconds": 0.25,
    "audio_level_poll_interval_seconds": 5.0,
    "microphone_test_duration_seconds": 5.0,
    "softphone_monitor_enabled": true,
    "softphone_poll_interval_seconds": 2.0,
    "softphone_high_cpu_percent": 85.0,
    "softphone_high_cpu_min_duration_seconds": 5.0,
    "softphone_high_memory_mb": 1024.0,
    "softphone_high_memory_min_duration_seconds": 5.0,
    "softphone_not_responding_min_duration_seconds": 3.0,
    "windows_events_enabled": true,
    "windows_events_poll_interval_seconds": 30.0,
    "power_audit_enabled": true,
    "power_audit_interval_seconds": 300.0
  },
  "thresholds": {
    "latency_warning_ms": 150,
    "latency_critical_ms": 300,
    "packet_loss_warning_percent": 1.0,
    "packet_loss_critical_percent": 3.0,
    "jitter_warning_ms": 30,
    "jitter_critical_ms": 60
  }
}
